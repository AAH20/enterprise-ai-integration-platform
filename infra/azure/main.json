{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "3986022500261941012"
    }
  },
  "parameters": {
    "suffix": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "deployIntegrationServices": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Deploy paid integration services only for a deliberate live demonstration. Disabled by default."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "workload": "enterprise-ai-integration-platform",
        "evidence": "synthetic-demo",
        "managedBy": "bicep"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('law-flowforge-{0}', parameters('suffix'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "retentionInDays": 30,
        "sku": {
          "name": "PerGB2018"
        }
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[format('appi-flowforge-{0}', parameters('suffix'))]",
      "location": "[parameters('location')]",
      "kind": "web",
      "tags": "[parameters('tags')]",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('law-flowforge-{0}', parameters('suffix')))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('law-flowforge-{0}', parameters('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[format('stflowforge{0}', parameters('suffix'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "condition": "[parameters('deployIntegrationServices')]",
      "type": "Microsoft.ServiceBus/namespaces",
      "apiVersion": "2024-01-01",
      "name": "[format('sb-flowforge-{0}', parameters('suffix'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "Standard",
        "tier": "Standard"
      },
      "properties": {
        "minimumTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "condition": "[parameters('deployIntegrationServices')]",
      "type": "Microsoft.ServiceBus/namespaces/queues",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}/{1}', format('sb-flowforge-{0}', parameters('suffix')), 'order-commands')]",
      "properties": {
        "deadLetteringOnMessageExpiration": true,
        "defaultMessageTimeToLive": "P1D",
        "duplicateDetectionHistoryTimeWindow": "PT10M",
        "requiresDuplicateDetection": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.ServiceBus/namespaces', format('sb-flowforge-{0}', parameters('suffix')))]"
      ]
    }
  ],
  "outputs": {
    "applicationInsightsId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/components', format('appi-flowforge-{0}', parameters('suffix')))]"
    },
    "receiptStorageId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Storage/storageAccounts', format('stflowforge{0}', parameters('suffix')))]"
    },
    "integrationServicesEnabled": {
      "type": "bool",
      "value": "[parameters('deployIntegrationServices')]"
    }
  }
}